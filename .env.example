# SmellScope environment configuration.
# Copy to `.env` (git-ignored). scripts/start.ps1 and scripts/start.sh load it automatically.
# Never commit real secrets. SmellScope is local-first and needs no API keys.

# --- Storage (paths are relative to the repository root unless absolute) ---
# Audit runs (results.json, split_manifest.json per run)
SMELLSCOPE_HOME=./runs
# Datasets: data/samples (bundled), data/uploads (user uploads), data/repaired, data/models
SMELLSCOPE_DATA_DIR=./data
# YAML configuration directory (canonical: ./config)
SMELLSCOPE_CONFIG_DIR=./config

# --- Backend server ---
SMELLSCOPE_HOST=127.0.0.1
SMELLSCOPE_PORT=8000

# --- Frontend dev server (Vite) ---
SMELLSCOPE_FRONTEND_PORT=5173

# --- Runtime tuning ---
# Silences joblib/loky physical-core detection warnings on Windows 11 (no `wmic`).
LOKY_MAX_CPU_COUNT=4
